# Copy to .env (never commit it). deploy.sh writes this file on the server for you.

# Host name Caddy gets a certificate for. Without a domain, use the static IP via sslip.io,
# e.g. 3-35-10-20.sslip.io (Terraform prints it as `site_address`). ":80" = plain HTTP (local test).
SITE_ADDRESS=:80

# prepared/<SEQUENCE> under DATA_DIR is what the server plays.
SEQUENCE=2024-11-02-17-10-25
DATA_DIR=./data

# --- Monthly transfer alerts (the site is never blocked; these only notify) ---
# Included transfer of the Lightsail plan. Change it together with bundle_id (small_3_0 = 3 TB).
TRANSFER_ALLOWANCE_GB=3000
# Alert when one hour alone sends more than this (about 3 viewers for a full hour).
SPIKE_GB_PER_HOUR=50
OVERAGE_USD_PER_GB=0.13
# NOTIFY_TEST=1 sends one test alert at every start; use it once to check the channels.
NOTIFY_TEST=

# Channels: leave empty to skip. The server log always gets the alert.
# Slack: Slack app > Incoming Webhooks > Add New Webhook (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=
# Discord: channel settings > Integrations > Webhooks > New Webhook (https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=
# Phone push: install the ntfy app and subscribe to a hard-to-guess topic, e.g. https://ntfy.sh/rls-7f3k9q2x
NTFY_TOPIC_URL=
# Any endpoint that accepts the structured JSON alert
ALERT_WEBHOOK_URL=
# E-mail over SMTP, e.g. Gmail with an app password: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# (@ in the user name must be written as %40)
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Local test only: publish on other host ports.
# HTTP_PORT=8080
# HTTPS_PORT=8443
