# One origin for the page and the server: no CORS, and wss:// comes with the HTTPS certificate.
# SITE_ADDRESS comes from .env (see .env.example). The site is open: anyone with the address can use it.
{$SITE_ADDRESS} {
	encode zstd gzip

	@server path /ws /health /manifest.json /static/*
	handle @server {
		reverse_proxy server:8787
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
